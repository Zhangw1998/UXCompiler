FIGMA_ACCESS_TOKEN=replace_with_your_figma_token
FIGMA_FILE_URL=https://www.figma.com/design/FILE_KEY/File-Name?node-id=1-2
# Use FIGMA_NODE_ID only when FIGMA_FILE_URL does not include node-id.
# FIGMA_NODE_ID=1:2
# Or select from the 1-based frame list printed by pnpm figma:smoke.
# FIGMA_FRAME_INDEX=1
UXCOMPILER_FIGMA_OUT=artifacts/my-figma-frame
# Optional for a Figma-compatible proxy or test server. Defaults to https://api.figma.com.
# FIGMA_API_BASE_URL=https://api.figma.com
