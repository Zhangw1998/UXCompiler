{
  "name": "uxcompiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "compile:sample": "pnpm build && node apps/cli/dist/index.js compile --input examples/fixtures/login_raw_figma_scene.json --out artifacts/sample",
    "verify:sample": "pnpm compile:sample && node scripts/verify-sample.mjs",
    "verify:override-engine": "pnpm build && node scripts/verify-override-engine.mjs",
    "verify:figma-mock": "pnpm build && node scripts/verify-figma-mock.mjs",
    "verify:local-api": "pnpm build && node scripts/verify-local-api.mjs",
    "verify:figma-plugin": "pnpm --filter @uxcompiler/figma-plugin build && node scripts/verify-figma-plugin-bridge.mjs",
    "verify:figma-ready": "node scripts/verify-figma-ready.mjs",
    "verify:figma-configure": "node scripts/verify-figma-configure.mjs",
    "verify:figma-access-audit": "node scripts/verify-figma-access-audit.mjs",
    "verify:figma-desktop-discover": "node scripts/verify-figma-desktop-discover.mjs",
    "verify:figma-next": "node scripts/verify-figma-next.mjs",
    "verify:figma-inspect-url": "node scripts/verify-figma-inspect-url.mjs",
    "verify:figma-smoke-config": "node scripts/verify-figma-smoke-config.mjs",
    "verify:figma-smoke-mock": "pnpm build && node scripts/verify-figma-smoke-mock.mjs",
    "verify:figma-bridge-smoke": "pnpm build && node scripts/figma-bridge-smoke.mjs",
    "verify:figma-plugin-session": "pnpm build && node scripts/verify-figma-plugin-session.mjs",
    "verify:figma-plugin-wait": "node scripts/verify-figma-plugin-wait.mjs",
    "verify": "pnpm verify:sample && pnpm verify:override-engine && pnpm verify:figma-mock && pnpm verify:local-api && pnpm verify:figma-plugin && pnpm verify:figma-ready && pnpm verify:figma-configure && pnpm verify:figma-access-audit && pnpm verify:figma-desktop-discover && pnpm verify:figma-next && pnpm verify:figma-inspect-url && pnpm verify:figma-smoke-config && pnpm verify:figma-smoke-mock && pnpm verify:figma-bridge-smoke && pnpm verify:figma-plugin-session && pnpm verify:figma-plugin-wait",
    "figma:ready": "node scripts/figma-ready.mjs",
    "figma:configure": "node scripts/figma-configure.mjs",
    "figma:access-audit": "node scripts/figma-access-audit.mjs",
    "figma:desktop-discover": "node scripts/figma-desktop-discover.mjs",
    "figma:next": "node scripts/figma-next.mjs",
    "figma:inspect-url": "node scripts/figma-inspect-url.mjs",
    "figma:smoke": "node scripts/figma-smoke.mjs",
    "figma:bridge-smoke": "pnpm build && node scripts/figma-bridge-smoke.mjs",
    "figma:plugin-start": "pnpm build && node scripts/figma-plugin-start.mjs",
    "figma:plugin-wait": "node scripts/figma-plugin-wait.mjs",
    "figma:plugin-stop": "node scripts/figma-plugin-stop.mjs",
    "local-api": "pnpm build && node apps/local-api/dist/index.js",
    "local-api:health": "node scripts/local-api-health.mjs",
    "clean": "rm -rf apps/*/dist packages/*/dist artifacts/sample artifacts/figma-mock artifacts/figma-smoke artifacts/figma-smoke-mock artifacts/figma-bridge-smoke artifacts/figma-readiness artifacts/figma-access-audit artifacts/local-api-smoke"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
